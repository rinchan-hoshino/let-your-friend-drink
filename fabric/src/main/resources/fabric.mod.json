{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "assets/let_your_friend_drink/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.rinchan.letyourfrienddrink.fabric.LetYourFriendDrinkFabric"
    ]
  },
  "mixins": [
    "let_your_friend_drink.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "letyourfriendeating": ">=${friend_eating_version}",
    "rinlib": ">=1.2.0"
  },
  "contact": {
    "sources": "https://github.com/rinchan-hoshino/let-your-friend-drink",
    "issues": "https://github.com/rinchan-hoshino/let-your-friend-drink/issues"
  }
